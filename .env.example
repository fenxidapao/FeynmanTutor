# FeynmanTutor 环境变量模板
# 用法: cp .env.example .env 然后填入真实值
# 完整变量清单见 config.py

# ---------- LLM（DeepSeek API 主力） ----------
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- Ollama 降级（仅断网/欠费兜底，费曼追问环节强制禁用） ----------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# ---------- CourseRAG（知识底座，HTTP 调用；未启动则 notes 兜底） ----------
# RAG_BASE_URL=http://127.0.0.1:8000
# RAG_RETRIEVE_TOP_N=8

# ---------- 状态库 ----------
# DB_PATH=state.db        # Docker 部署时指向挂载卷 /app/data/state.db

# ---------- 沙箱 ----------
# SANDBOX_TIMEOUT=5
# SANDBOX_MAX_OUTPUT=65536
